# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Runtime / experiments
.runs/
# Recorded hardware runs (runs/) are version controlled: their outputs are not
# regenerable. Only the tarballs they arrive in are ignored, once extracted.
*.tar.gz
results/
*.tsv
# ...except an experiment's ledger, which is its result, not runtime output.
!experiments/**/results.tsv
!experiments/generation/e3-red-team/recorded/**/ledger.tsv
wandb/

# GPU build artifacts
*.so
*.o
*.cubin

# IDE / OS
.DS_Store
.idea/
.vscode/
*.swp

# Reference PDFs (large; use manifest + local download)
reference/**/*.pdf

# Secrets
.env
.env.*

# Agent worktrees
.claude/worktrees/

# Rocq build artefacts. tests/proofs compiles in a temporary copy; these appear only when a proof
# is compiled by hand in place.
proofs/**/*.vo
proofs/**/*.vok
proofs/**/*.vos
proofs/**/*.glob
proofs/**/.*.aux
proofs/**/.lia.cache
